# Copy this to the repo root as `.env` on the server and fill in real values.
#   cp deploy/env.production.example .env && chmod 600 .env

# The DB password is used by BOTH docker-compose.prod.yml and DATABASE_URL.
# Keep the two identical.
POSTGRES_PASSWORD="change-me-to-a-long-random-password"
DATABASE_URL="postgresql://taskflow:change-me-to-a-long-random-password@localhost:5432/taskflow?schema=public"

# Auth.js (NextAuth v5)
#   Generate a fresh secret:  openssl rand -base64 32
AUTH_SECRET="change-me-fresh-secret"
# Must be your real public HTTPS URL, or login cookies will not persist.
AUTH_URL="https://taskflow.example.com"

NODE_ENV="production"
